  "d.onHighlightStarted S0 el=intro index=0 | i=0 step=S1/S1 el=card-1/card-1 prev=none/none",
  "d.onPopoverRender S0 index=0 | i=0 step=S0/S1 el=intro/card-1 prev=S1/none T",
  "-- right after: i=0 step=S0/S1 el=intro/card-1 prev=S1/none T",
