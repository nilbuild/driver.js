  "d.onHighlighted S0 el=intro index=0 | i=0 step=S0/S0 el=intro/intro prev=S1/S1 T",
  "-- a frame later: i=0 step=S0/S0 el=intro/intro prev=S1/S1",
  "   popovers=1/1 title=S0 flags=- next=Next prev=disabled busy=- overlays=1 active=intro aria=intro dummy=n live=1 body=driver-active driver-simple focus=body",
