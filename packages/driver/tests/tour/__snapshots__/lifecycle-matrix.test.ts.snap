exports[`while 'active' > ArrowLeft 1`] = `
[
  "d.onHighlightStarted S1 el=card-1 index=1 | i=1 step=none/none el=none/none prev=none/none",
  "d.onPopoverRender S1 index=1 | i=1 step=S1/none el=card-1/none prev=none/none T",
  "d.onHighlighted S1 el=card-1 index=1 | i=1 step=S1/S1 el=card-1/card-1 prev=none/none T",
  "== active: i=1 step=S1/S1 el=card-1/card-1 prev=none/none",
