---
import { ClientRouter } from "astro:transitions";
import BaseLayout from "./BaseLayout.astro";
import { DocsHeader } from "../components/DocsHeader";
import Sidebar from "../components/Sidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { getSidebarGroups } from "../lib/guide";

export interface Props {
  guide: CollectionEntry<"guides">;
  headings: MarkdownHeading[];
}

const groups = await getSidebarGroups();

const { guide, headings } = Astro.props;
const { title, description } = guide.data;

const metaDescription =
  description ??
  `${title} — learn how to use Driver.js, the lightweight, no-dependency JavaScript library for product tours, feature highlights and contextual help.`;
---

<BaseLayout title={`${title} - Driver.js`} description={metaDescription} permalink={`/docs/${guide.id}`}>
  <ClientRouter slot="head" fallback="swap" />
  <link slot="head" rel="alternate" type="text/markdown" href={`/docs/${guide.id}.md`} title="This page as Markdown" />
  <div class="sticky top-0 z-40 md:hidden">
    <DocsHeader activeGuideId={guide.id} groups={groups} client:load />
  </div>
  <div class="flex">
    <Sidebar activeGuideId={guide.id} groups={groups} />
    <main class="min-w-0 flex-1 px-5 pt-8 pb-32 md:pl-12 md:pr-10 md:pt-12 xl:pl-28 xl:pt-20">
      <article
        class:list={[
          "docs-content prose max-w-[640px]",
          { "changelog-page": guide.id === "changelog" },
        ]}>
        <h1>{title}</h1>
        <slot />
      </article>
    </main>
    <TableOfContents headings={headings} maxDepth={guide.id === "changelog" ? 2 : 3} />
  </div>
</BaseLayout>

<script>
  import { driver } from "driver.js";

  // driver.js tears down the running tour whenever another driver starts, so a
  // throwaway driver ends any demo tour before the page body is swapped out.
  // ClientRouter sets scroll restoration to manual and only restores the
  // position from script, after first paint. Let the browser restore it on reload.
  window.addEventListener("pagehide", () => {
    history.scrollRestoration = "auto";
  });

  document.addEventListener("astro:before-swap", () => {
    if (!document.body.classList.contains("driver-active")) {
      return;
    }

    const sweeper = driver({ animate: false });
    sweeper.highlight({ popover: { description: "" } });
    sweeper.destroy();
  });
</script>
