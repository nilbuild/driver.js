---
import type { MarkdownHeading } from "astro";

export interface Props {
  headings: MarkdownHeading[];
  maxDepth: number;
}

const { headings, maxDepth } = Astro.props;
const items = headings.filter(heading => heading.depth >= 2 && heading.depth <= maxDepth);
---

{items.length >= 2 && (
  <nav id="docs-toc" aria-label="On this page" class="hidden min-[1200px]:block w-[240px] xl:w-[260px] flex-shrink-0 pr-8 xl:pr-16 pt-12 xl:pt-20">
    <div class="sticky top-20 text-[13px] leading-[1.3] tracking-[-0.01em]">
      <h2 class="mb-2 font-normal text-neutral-400">On this page</h2>
      <ul>
        {items.map(heading => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-toc-link={heading.slug}
              class:list={["block py-1 text-black/50 transition-colors duration-100 hover:text-black data-[active]:text-black", { "pl-3": heading.depth > 2 }]}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<script>
  let controller: AbortController | undefined;

  function trackActiveHeading() {
    controller?.abort();
    controller = undefined;

    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
    const headings = links
      .map(link => document.getElementById(link.dataset.tocLink!))
      .filter((heading): heading is HTMLElement => heading !== null);
    if (!links.length) {
      return;
    }

    function markActive() {
      const current = headings.filter(heading => heading.getBoundingClientRect().top < 120).at(-1) ?? headings[0];
      links.forEach(link => {
        link.toggleAttribute("data-active", link.dataset.tocLink === current?.id);
      });
    }

    controller = new AbortController();
    markActive();
    window.addEventListener("scroll", markActive, { passive: true, signal: controller.signal });
  }

  document.addEventListener("astro:page-load", trackActiveHeading);
</script>
